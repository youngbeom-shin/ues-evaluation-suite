  "tasks": [
    {
      "id": "T01",
      "role": "首次使用者",
      "goal": "发起一项可控的测试任务，并理解当前执行状态和下一步。",
      "entry": "WebUI 或桌面端的 Manager 会话；具体入口待现场核对。",
      "preconditions": [
        "运行地址与被测版本已明确",
        "使用隔离的测试工作区和样本数据",
        "执行测试任务的授权已在本轮明确"
      ],
      "success_outcome": "任务被接收；用户能识别是否执行中、等待输入、失败或已完成，并理解可执行的下一步。",
      "evidence_requirements": [
        "任务提交前后的界面",
        "实际展示的状态及时间顺序",
        "需要用户输入时的问题与恢复执行结果"
      ],
      "basis_source_ids": [
        "product-readme",
        "interaction"
      ],
      "basis": "基于产品文档提出的试点候选任务；不是用户已确认的任务链。"
    },
    {
      "id": "T02",
      "role": "处理执行异常的使用者",
      "goal": "识别任务失败或阻断原因，并在产品支持的范围内恢复。",
      "entry": "T01 的测试任务中可控、可复现的异常状态。",
      "preconditions": [
        "存在可控的异常测试条件",
        "先核实原任务实际状态",
        "产品提供的恢复能力已核对"
      ],
      "success_outcome": "用户理解失败或阻断原因；如支持恢复，可完成恢复并确认状态；如不支持，可理解限制及可行下一步。",
      "evidence_requirements": [
        "异常触发条件",
        "失败或阻断反馈",
        "恢复动作及最终状态，或限制说明"
      ],
      "basis_source_ids": [
        "interaction",
        "walkthrough-plan"
      ],
      "basis": "依据 FLOW-01/02/03 提出的候选；不预设产品已有取消、重试或断点恢复功能。"
    },
    {
      "id": "T03",
      "role": "核验交付结果的使用者",
      "goal": "核验任务结果，并访问本次任务承诺交付的产物。",
      "entry": "测试任务显示完成后的结果消息。",
      "preconditions": [
        "事前约定任务成功真值和产物类型",
        "仅使用测试文件及当前角色可访问资源"
      ],
      "success_outcome": "用户能将结果与原任务对应，核验承诺的产物可访问且内容满足成功真值；状态和实际交付一致。",
      "evidence_requirements": [
        "事前冻结的成功真值",
        "完成消息",
        "实际打开的产物及核验记录"
      ],
      "basis_source_ids": [
        "product-readme",
        "interaction"
      ],
      "basis": "基于产品的结果汇总目标提出的候选；具体任务与产物需在本轮确认。"
    }
  ],
  "support_matrix": {
    "status": "proposed",
    "browsers": [],
