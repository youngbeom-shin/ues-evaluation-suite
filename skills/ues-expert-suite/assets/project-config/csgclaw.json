      "多条记录"
    ]
  },
  "rule_mappings": [
    {
      "rule_id": "LAY-01",
      "source_id": "interaction",
      "specialists": [
        "ues-baseline-gate",
        "ease-of-use-suite-47",
        "consistency-suite-22"
      ],
      "focus": "检查约定视口下的可读性、操作可达性及意外溢出。"
    },
    {
      "rule_id": "TXT-04",
      "source_id": "interaction",
      "specialists": [
        "ease-of-use-suite-47",
        "consistency-suite-22"
      ],
      "focus": "以实际中英文、状态与可用空间检查按钮语义和适配。"
    },
    {
      "rule_id": "LOC-02",
      "source_id": "interaction",
      "specialists": [
        "ease-of-use-suite-47",
        "consistency-suite-22"
      ],
      "focus": "检查语言切换、长标签、浮层反馈及编辑内容保留。"
    },
    {
      "rule_id": "FORM-03",
      "source_id": "interaction",
      "specialists": [
        "ues-baseline-gate",
        "ease-of-use-suite-47"
      ],
      "focus": "检查焦点、键盘以及输入法确认是否误提交。"
    },
    {
      "rule_id": "FLOW-02",
      "source_id": "interaction",
      "specialists": [
        "ease-of-use-suite-47",
        "task-experience-score"
      ],
      "focus": "检查进行中反馈、重复提交防护和结果可见性。"
    },
    {
      "rule_id": "FLOW-03",
      "source_id": "interaction",
      "specialists": [
        "ease-of-use-suite-47",
        "task-experience-score"
      ],
      "focus": "检查异常解释、原状态核实和实际支持的恢复路径。"
    },
    {
      "rule_id": "FLOW-05",
      "source_id": "interaction",
      "specialists": [
        "ues-baseline-gate",
        "consistency-suite-22"
      ],
      "focus": "在存在角色限制时检查入口、不可用状态与权限反馈。"
    }
  ],
  "authorization": {
